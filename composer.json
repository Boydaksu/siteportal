{
  "name": "boydaksu/siteportal",
  "description": "SitePortal - Guvenli cekirdek ve moduler web araclari platformu",
  "type": "project",
  "require": {
    "php": ">=8.4 <9.0"
  },
  "require-dev": {
    "phpunit/phpunit": "12.5.43",
    "phpstan/phpstan": "2.3.5",
    "squizlabs/php_codesniffer": "4.0.4"
  },
  "autoload": {
    "psr-4": {
      "SitePortal\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SitePortal\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false,
    "secure-http": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
