{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO issue result contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "rule_id",
    "rule_version",
    "status",
    "severity",
    "confidence",
    "data_source",
    "evidence",
    "observed_at"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 2
    },
    "rule_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Maskeli kanıt nesneleri; veri yoksa boş dizi, sahte kanıt üretilmez."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "affected_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "data_source": {
      "type": "string"
    }
  },
  "description": "F00.03 Q-001 kullanıcı onaylı taslak: data_source ve nesnelerden oluşan evidence dizisi. Gerçek API henüz uygulanmadı."
}
